# Postgres connection (Vercel Postgres sets POSTGRES_URL automatically)
POSTGRES_URL=postgres://user:password@host:5432/database

# Secret for session signing (generate a random string)
SESSION_SECRET=

# Secret for protecting cron endpoints (generate a random string)
CRON_SECRET=

# Apify API token for fetching Instagram Reels data
# Get yours at https://console.apify.com/account/integrations
APIFY_API_TOKEN=
